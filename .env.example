# Overrides for `docker-compose.yml` host port bindings and public URLs.
# Copy to `.env` in the repo root (docker compose loads it automatically)
# when the defaults collide with other things already running on the host,
# or when deploying behind a reverse proxy with real hostnames.

# Host ports (container ports never change, only what's published)
WEB_PORT=3001
SERVER_PORT=3000
MINIO_CONSOLE_PORT=9001
# POSTGRES_PORT=5432   # only if you uncomment the port mapping in compose
# OCR_PORT=8100        # only if you uncomment the port mapping in compose

# Public URLs a browser can actually reach (behind a reverse proxy, use your
# real hostnames here, e.g. https://receiving.example.com)
WEB_PUBLIC_SERVER_URL=http://localhost:3000
WEB_PUBLIC_ORIGIN=http://localhost:3001
