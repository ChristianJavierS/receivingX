DATABASE_URL=postgresql://receivingx:receivingx@localhost:5432/receivingx
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-char-string
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
APP_URL=http://localhost:3001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=receivingx
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Only needed when S3_ENDPOINT (above) isn't reachable by a browser, e.g. in
# Docker where it's the internal service name `minio`. Set this to whatever
# URL a browser CAN reach for the MinIO API port (see MINIO_API_PORT in the
# root .env.example) - presigned photo upload/download URLs are signed
# against this host.
# S3_PUBLIC_ENDPOINT=http://192.168.1.224:9000

OCR_URL=http://localhost:8100
OCR_TIMEOUT_MS=20000

# Microsoft Graph app registration - client credentials, Mail.Send application permission
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_UPN=receiving@yourdomain.com

# InvenTree
INVENTREE_URL=https://inventree.yourdomain.com
INVENTREE_TOKEN=
INVENTREE_DEFAULT_LOCATION=

# Fallback recipients if a Location doesn't have its own set
RECEIVING_EMAIL=
ACCOUNTING_EMAILS=
